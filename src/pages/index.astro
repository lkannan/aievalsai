---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, getPublishedPosts } from '../lib/posts';

const posts = (await getPublishedPosts()).slice(0, 5);
const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<BaseLayout title={SITE.title}>
  <h1>{SITE.title}</h1>
  <p>
    Hi, I'm Kannan — a quality engineer working on AI evaluations, agents, and
    MCP testing. This is where I write about making AI systems reliable: how to
    evaluate them, where they break, and what quality means when the output is
    non-deterministic.
  </p>

  <h2>Latest posts</h2>
  {
    posts.length === 0 ? (
      <p class="muted">No posts yet — check back soon.</p>
    ) : (
      <ul class="post-list">
        {posts.map((post) => (
          <li>
            <h2>
              <a href={`/posts/${post.id}/`}>{post.data.title}</a>
            </h2>
            <p class="post-meta">{fmt(post.data.pubDate)}</p>
            <p>{post.data.description}</p>
          </li>
        ))}
      </ul>
    )
  }

  <p><a href="/posts">See all posts →</a></p>
</BaseLayout>
