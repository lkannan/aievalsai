---
import BaseLayout from '../../layouts/BaseLayout.astro';

// Interactive HTML documents live in `public/labs/*.html` and are served
// verbatim. Add one entry here per artifact — newest first.
type Lab = {
  title: string;
  description: string;
  file: string; // filename inside public/labs/
  date: string; // ISO date, for display + sort
};

const labs: Lab[] = [
  {
    title: 'RAG Pattern Atlas',
    description:
      'An interactive map of retrieval-augmented generation patterns — the moving parts, how they connect, and where each design fits.',
    file: 'rag-pattern-atlas.html',
    date: '2026-09-30',
  },
];

labs.sort((a, b) => b.date.localeCompare(a.date));

const fmt = (iso: string) =>
  new Date(iso).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
---

<BaseLayout
  title="Labs"
  description="Interactive documents and simulations for understanding AI concepts — built while learning."
>
  <h1>Labs</h1>
  <p class="muted">
    Interactive, self-contained documents I build while learning AI concepts —
    each one is a small simulation, map, or explainer you can poke at.
  </p>
  {
    labs.length === 0 ? (
      <p class="muted">Nothing here yet — check back soon.</p>
    ) : (
      <ul class="post-list">
        {labs.map((lab) => (
          <li>
            <h2>
              <a href={`/labs/${lab.file}`}>{lab.title}</a>
            </h2>
            <p class="post-meta">{fmt(lab.date)}</p>
            <p>{lab.description}</p>
          </li>
        ))}
      </ul>
    )
  }
</BaseLayout>
